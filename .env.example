# Скопируй в .env.development и .env.production и заполни.
# Секреты в репозиторий не коммитим.

# --- Окружение ---
# dev: порт 3001, база data/dev.db | prod: порт 3000, база data/prod.db
NITRO_PORT=3001
DATABASE_URL=file:./data/dev.db

# Бот в dev по умолчанию выключен, чтобы не отвечать в чат дважды
# (в .env.production поставь true)
BOT_ENABLED=false

# Адрес Nuxt (dev: 3001, prod: 3000): оттуда грузится оверлей, туда ведёт ссылка входа в Twitch
OVERLAY_URL=http://localhost:3001
# Общий секрет бот <-> Nuxt (пока не используется: Socket.io-сервер живёт в боте)
INTERNAL_SECRET=CHANGE_ME

# --- Socket.io (сервер в боте, оверлей подключается к нему) ---
# Порт одинаковый для бота и Nuxt (оба читают этот файл). По умолчанию 3002.
# Чтобы держать dev и prod одновременно, задайте разные: например dev 3002, prod 3003.
SOCKET_PORT=3002
# Слушаем только свою машину. Для OBS на другом компьютере: 0.0.0.0
# SOCKET_HOST=127.0.0.1
# Полный адрес сервера для оверлея, если он не на том же хосте, что страница
# SOCKET_URL=
# Эмулятор событий (/dev/events). По умолчанию включён везде, кроме NODE_ENV=production
# DEV_EVENTS=true

# --- Twitch ---
TWITCH_CHANNEL_NAME=luckyfoxcode
TWITCH_USER_ID=99200545
TWITCH_BOT_ID=1502579014
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Префикс команд: dev — !t (!tcoins, !tprofile), prod — ! (чтобы dev-бот не дублировал ответы боевого)
COMMAND_PREFIX=!t
# Redirect URL OAuth бота: добавить в консоли Twitch байт в байт (dev: порт 3001, prod: 3000)
TWITCH_BOT_REDIRECT_URI=http://localhost:3001/auth/twitch/callback

# --- Админка ---
ADMIN_TWITCH_USER_ID=
ADMIN_SESSION_SECRET=CHANGE_ME
ADMIN_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/twitch/callback

# --- Лотерея VIP ---
# Менять ли VIP на самом Twitch при розыгрыше (!runlottery). По умолчанию: в prod да, в dev нет.
# dev-база — копия боевой, и розыгрыш в ней иначе снимал бы и выдавал настоящие VIP зрителям.
# Включить в dev на свой риск: true
# LOTTERY_TWITCH_VIP=false

# --- Музыкальный виджет «сейчас играет» (только Windows) ---
# Бот сам запускает читателя системного плеера (powershell.exe), ничего ставить не нужно.
# Выключить: false. На Mac и Linux читатель не запускается сам.
# MUSIC_ENABLED=true
# Как часто опрашивать систему, мс (по умолчанию 1000, не меньше 200)
# MUSIC_POLL_MS=1000
